# Public application origin used by wallet metadata and Open Graph links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser-reachable local Anvil RPC. Use the VM LAN address when the browser is
# on another machine, for example http://192.168.50.138:8545.
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_GAME_MODE=simulator
NEXT_PUBLIC_LAST_BELL_ROUND_ADDRESS=
NEXT_PUBLIC_DEV_DOLLAR_ADDRESS=
NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=
NEXT_PUBLIC_ROUND_MANAGER_ADDRESS=
NEXT_PUBLIC_UAT_WALLET_ENABLED=false

# Create this in the Reown dashboard and allowlist every deployed app origin.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Browser traffic uses the same-origin RPC relay. Override only when the browser
# should connect to a public provider directly.
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=

# Server-only RPC routing. LAN nodes are primary; provider URLs are fallback.
ROBINHOOD_TESTNET_RPC_URL=http://192.168.50.117:8547
ROBINHOOD_MAINNET_RPC_URL=http://192.168.50.173:8547
ROBINHOOD_TESTNET_FALLBACK_RPC_URL=
ROBINHOOD_MAINNET_FALLBACK_RPC_URL=
DATABASE_URL=postgresql:///keygame?host=/var/run/postgresql
KEYGAME_CHAIN_ID=46630
KEYGAME_DEPLOYMENT_MANIFEST=

# Testnet deployment only. Use encrypted keystores and owner-only password
# files. Never store raw private keys in this file.
DEPLOYER_ADDRESS=
ADMIN_ADDRESS=
KEEPER_ADDRESS=
ATTESTOR_ADDRESS=
FAUCET_ADDRESS=
TREASURY_ADDRESS=
INITIAL_SEED_USDG=50000000
KEYGAME_DEPLOYER_KEYSTORE=
KEYGAME_DEPLOYER_PASSWORD_FILE=
KEYGAME_KEEPER_KEYSTORE=
KEYGAME_KEEPER_PASSWORD_FILE=
KEYGAME_ATTESTOR_KEYSTORE=
KEYGAME_ATTESTOR_PASSWORD_FILE=
KEYGAME_FAUCET_KEYSTORE=
KEYGAME_FAUCET_PASSWORD_FILE=

# Server-only adapter that acquires Chainlink Data Streams signed report bytes.
# The adapter must return report, price, observedAt, band, and multiplierBps.
DATA_STREAMS_REPORT_ADAPTER_URL=
DATA_STREAMS_REPORT_ADAPTER_TOKEN=
DATA_STREAMS_FEED_MAP_JSON={}
CHAINLINK_CLIENT_ID=
CHAINLINK_CLIENT_SECRET=
CHAINLINK_API_URL=
CHAINLINK_WEBSOCKET_URL=
DATA_STREAMS_ADAPTER_HOST=127.0.0.1
DATA_STREAMS_ADAPTER_PORT=8787

# Server-only 30-minute sample collector. Run it 60 seconds before round
# configuration; the app applies deterministic eligibility and ranking rules.
ROBINHOOD_MARKET_SCREEN_ADAPTER_URL=
ROBINHOOD_MARKET_SCREEN_ADAPTER_TOKEN=
KEYGAME_UAT_ENABLED=false
