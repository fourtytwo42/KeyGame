[Unit]
Description=Last Bell one-hour mainnet canary runner
After=network-online.target postgresql.service keygame-indexer.service keygame-keeper.service
Wants=network-online.target

[Service]
Type=oneshot
User=hendo420
WorkingDirectory=/home/hendo420/projects/KeyGame
EnvironmentFile=/etc/keygame/mainnet.env
Environment=PATH=/home/hendo420/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/hendo420/.nvm/versions/node/v24.18.0/bin/corepack pnpm mainnet-canary:run
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/hendo420/.config/keygame /usr/local/libexec/keygame-canary-restart
ReadWritePaths=/home/hendo420/projects/KeyGame /var/run/postgresql

[Install]
WantedBy=multi-user.target
