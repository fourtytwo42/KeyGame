[Unit]
Description=KeyGame testnet audit soak controller
After=network-online.target postgresql.service keygame-dex-market.service keygame-indexer.service keygame-keeper.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hendo420/projects/KeyGame
EnvironmentFile=/home/hendo420/.config/keygame/testnet.env
Environment=PATH=/home/hendo420/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/hendo420/.nvm/versions/node/v24.18.0/bin/corepack pnpm service:soak
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/hendo420/.config/keygame
ReadWritePaths=/home/hendo420/projects/KeyGame /var/run/postgresql

[Install]
WantedBy=default.target
