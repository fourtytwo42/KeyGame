[Unit]
Description=Last Bell chain-31337 one-hour launch rehearsal runner
After=network-online.target postgresql.service keygame-v4-rehearsal-indexer.service keygame-v4-rehearsal-keeper.service
Wants=network-online.target

[Service]
Type=oneshot
User=hendo420
WorkingDirectory=/home/hendo420/projects/KeyGame
EnvironmentFile=/etc/keygame/v4-rehearsal.env
Environment=PATH=/home/hendo420/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/hendo420/.nvm/versions/node/v24.18.0/bin/corepack pnpm v4-launch-rehearsal:run
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/usr/local/libexec/keygame-v4-rehearsal-restart
ReadWritePaths=/home/hendo420/projects/KeyGame /var/run/postgresql

[Install]
WantedBy=multi-user.target
