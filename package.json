{
  "name": "last-bell",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:test && pnpm build && pnpm test:e2e",
    "devnet:start": "bash scripts/devnet-start.sh",
    "devnet:stop": "bash scripts/devnet-stop.sh",
    "devnet:deploy": "bash scripts/devnet-deploy.sh",
    "app:start": "bash scripts/app-start.sh",
    "app:stop": "bash scripts/app-stop.sh",
    "chain": "anvil --chain-id 31337 --block-time 1",
    "contracts:build": "forge build",
    "contracts:test": "forge test -vvv",
    "contracts:deploy:local": "forge script script/DeployLocal.s.sol:DeployLocal --rpc-url http://127.0.0.1:8545 --broadcast",
    "contracts:deploy:testnet": "forge script script/DeployTestnet.s.sol:DeployTestnet --rpc-url \"$ROBINHOOD_TESTNET_RPC_URL\" --broadcast --verify"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.55.10",
    "wagmi": "^3.7.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
