{
  "name": "last-bell",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "bash scripts/run-v4-integration.sh",
    "test:integration:raw": "vitest run --config vitest.integration.config.ts",
    "test:migrations": "bash scripts/test-mainnet-canary-migration.sh && bash scripts/test-launch-rehearsal-migration.sh",
    "test:e2e": "bash scripts/run-v4-e2e.sh",
    "test:e2e:raw": "playwright test",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:test && pnpm build && pnpm test:e2e",
    "devnet:start": "bash scripts/devnet-start.sh",
    "devnet:stop": "bash scripts/devnet-stop.sh",
    "devnet:deploy": "bash scripts/devnet-deploy.sh",
    "app:start": "bash scripts/app-start.sh",
    "app:stop": "bash scripts/app-stop.sh",
    "chain": "anvil --chain-id 31337 --block-time 1",
    "contracts:build": "forge build",
    "contracts:test": "forge test -vvv",
    "db:migrate": "tsx services/migrate.ts",
    "db:backfill-deployments": "tsx scripts/backfill-deployment-history.ts",
    "readiness:dex-economics": "tsx scripts/dex-economic-screen.ts",
    "readiness:rug-latency": "tsx scripts/rug-zone-latency-simulation.ts",
    "soak:start": "tsx scripts/testnet-soak.ts start",
    "soak:run": "tsx scripts/testnet-soak.ts run",
    "soak:status": "tsx scripts/testnet-soak.ts status",
    "soak:reconcile": "tsx scripts/testnet-soak.ts reconcile",
    "soak:fixtures": "tsx scripts/soak-isolated-fixtures.ts",
    "soak:wallets": "tsx scripts/generate-soak-keystores.ts",
    "soak:fund": "tsx scripts/fund-soak-wallets.ts",
    "v4-soak:start": "tsx scripts/v4-devnet-soak.ts start",
    "v4-soak:run": "tsx scripts/v4-devnet-soak.ts run",
    "v4-soak:status": "tsx scripts/v4-devnet-soak.ts status",
    "v4-soak:reconcile": "tsx scripts/v4-devnet-soak.ts reconcile",
    "v4-soak:report": "tsx scripts/v4-devnet-soak.ts report",
    "v4-soak:endurance:start": "V4_SOAK_PROFILE=endurance tsx scripts/v4-devnet-soak.ts start",
    "v4-soak:endurance:run": "V4_SOAK_PROFILE=endurance tsx scripts/v4-devnet-soak.ts run",
    "v4-torture:contracts": "bash scripts/v4-torture-contracts.sh",
    "v4-torture:start": "bash scripts/v4-torture.sh start",
    "v4-torture:run": "bash scripts/v4-torture.sh run",
    "v4-torture:status": "bash scripts/v4-torture.sh status",
    "v4-torture:replay": "bash scripts/v4-torture.sh replay",
    "v4-torture:reconcile": "bash scripts/v4-torture.sh reconcile",
    "v4-torture:report": "bash scripts/v4-torture.sh report",
    "v4-torture:stop": "bash scripts/v4-torture.sh stop",
    "service:market": "tsx services/market-collector.ts",
    "service:dex-market": "tsx services/dex-market-adapter.ts",
    "service:indexer": "tsx services/indexer.ts",
    "service:keeper": "tsx services/keeper.ts",
    "service:soak": "tsx services/soak-controller.ts",
    "service:v4-devnet-keeper": "tsx services/v4-devnet-keeper.ts",
    "service:v4-keeper": "tsx services/v4-keeper.ts",
    "release:scan": "bash scripts/scan-protected-build.sh",
    "release:scan:mainnet": "bash scripts/scan-mainnet-protected-build.sh",
    "release:prepare:testnet:v4": "bash scripts/prepare-testnet-v4-worktree.sh",
    "release:preflight:mainnet": "tsx scripts/preflight-mainnet-v4.ts",
    "release:preflight:testnet:v4": "bash scripts/preflight-testnet-v4.sh",
    "release:reconcile:testnet:v4": "tsx scripts/reconcile-testnet-v4-smoke.ts",
    "release:verify:testnet:v4-bytecode": "tsx scripts/verify-testnet-v4-bytecode.ts",
    "release:write-manifest:v4": "tsx scripts/write-v4-deployment-manifest.ts",
    "release:package:audit": "bash scripts/package-audit-candidate-v4.sh",
    "release:package:internal-assurance": "bash scripts/package-audit-candidate-v4.sh",
    "release:deploy:mainnet": "bash scripts/deploy-mainnet-v4.sh",
    "release:budget:mainnet": "tsx scripts/estimate-mainnet-release-budget.ts",
    "release:verify:mainnet:read-only": "tsx scripts/verify-mainnet-read-only.ts",
    "release:verify:mainnet:promotion": "tsx scripts/verify-mainnet-promotion-authorization.ts",
    "v4-launch-rehearsal:dry-run": "bash scripts/run-v4-launch-rehearsal-dry-run.sh",
    "v4-launch-rehearsal:install": "sudo bash scripts/install-v4-launch-rehearsal-services.sh",
    "v4-launch-rehearsal:prepare": "bash scripts/prepare-v4-launch-rehearsal.sh",
    "v4-launch-rehearsal:start": "tsx scripts/v4-launch-rehearsal.ts start",
    "v4-launch-rehearsal:run": "tsx scripts/v4-launch-rehearsal.ts run",
    "v4-launch-rehearsal:status": "tsx scripts/v4-launch-rehearsal.ts status",
    "v4-launch-rehearsal:reconcile": "tsx scripts/v4-launch-rehearsal.ts reconcile",
    "v4-launch-rehearsal:report": "tsx scripts/v4-launch-rehearsal.ts report",
    "roles:generate": "tsx scripts/generate-role-keystores.ts",
    "release:verify-safes": "tsx scripts/verify-mainnet-safes.ts",
    "release:verify-role-custody": "tsx scripts/verify-single-deployer-roles.ts",
    "release:verify-role-handoff": "tsx scripts/verify-v4-role-handoff.ts",
    "security:review": "bash scripts/run-internal-security-review.sh",
    "security:install": "bash scripts/install-security-toolchain.sh",
    "security:negative-controls": "bash scripts/run-security-negative-controls.sh",
    "security:verify-tools": "tsx scripts/verify-security-tool-versions.ts",
    "contracts:deploy:local": "forge script script/DeployLocal.s.sol:DeployLocal --rpc-url http://127.0.0.1:8545 --broadcast",
    "contracts:deploy:testnet": "forge script script/DeployTestnet.s.sol:DeployTestnet --rpc-url \"$ROBINHOOD_TESTNET_RPC_URL\" --broadcast --verify",
    "contracts:deploy:testnet:v4": "bash scripts/deploy-testnet-v4.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "ethers": "^6.17.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.55.10",
    "wagmi": "^3.7.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
