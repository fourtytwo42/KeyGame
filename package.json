{
  "name": "last-bell",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:test && pnpm build && pnpm test:e2e",
    "devnet:start": "bash scripts/devnet-start.sh",
    "devnet:stop": "bash scripts/devnet-stop.sh",
    "devnet:deploy": "bash scripts/devnet-deploy.sh",
    "app:start": "bash scripts/app-start.sh",
    "app:stop": "bash scripts/app-stop.sh",
    "chain": "anvil --chain-id 31337 --block-time 1",
    "contracts:build": "forge build",
    "contracts:test": "forge test -vvv",
    "db:migrate": "tsx services/migrate.ts",
    "db:backfill-deployments": "tsx scripts/backfill-deployment-history.ts",
    "readiness:dex-economics": "tsx scripts/dex-economic-screen.ts",
    "readiness:rug-latency": "tsx scripts/rug-zone-latency-simulation.ts",
    "soak:start": "tsx scripts/testnet-soak.ts start",
    "soak:run": "tsx scripts/testnet-soak.ts run",
    "soak:status": "tsx scripts/testnet-soak.ts status",
    "soak:reconcile": "tsx scripts/testnet-soak.ts reconcile",
    "soak:fixtures": "tsx scripts/soak-isolated-fixtures.ts",
    "soak:wallets": "tsx scripts/generate-soak-keystores.ts",
    "soak:fund": "tsx scripts/fund-soak-wallets.ts",
    "v4-soak:start": "tsx scripts/v4-devnet-soak.ts start",
    "v4-soak:run": "tsx scripts/v4-devnet-soak.ts run",
    "v4-soak:status": "tsx scripts/v4-devnet-soak.ts status",
    "v4-soak:reconcile": "tsx scripts/v4-devnet-soak.ts reconcile",
    "v4-soak:report": "tsx scripts/v4-devnet-soak.ts report",
    "v4-soak:endurance:start": "V4_SOAK_PROFILE=endurance tsx scripts/v4-devnet-soak.ts start",
    "v4-soak:endurance:run": "V4_SOAK_PROFILE=endurance tsx scripts/v4-devnet-soak.ts run",
    "service:market": "tsx services/market-collector.ts",
    "service:dex-market": "tsx services/dex-market-adapter.ts",
    "service:indexer": "tsx services/indexer.ts",
    "service:keeper": "tsx services/keeper.ts",
    "service:soak": "tsx services/soak-controller.ts",
    "service:v4-devnet-keeper": "tsx services/v4-devnet-keeper.ts",
    "release:scan": "bash scripts/scan-protected-build.sh",
    "roles:generate": "tsx scripts/generate-role-keystores.ts",
    "release:verify-safes": "tsx scripts/verify-mainnet-safes.ts",
    "contracts:deploy:local": "forge script script/DeployLocal.s.sol:DeployLocal --rpc-url http://127.0.0.1:8545 --broadcast",
    "contracts:deploy:testnet": "forge script script/DeployTestnet.s.sol:DeployTestnet --rpc-url \"$ROBINHOOD_TESTNET_RPC_URL\" --broadcast --verify"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "ethers": "^6.17.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.55.10",
    "wagmi": "^3.7.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
